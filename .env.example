# ==============================================================================
# T&JPork Production Environment Variables (.env)
# Copy this file to .env on your server or local environment:
#   cp .env.example .env
# ==============================================================================
# ==============================================================================
# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Connection String
# ------------------------------------------------------------------------------
# Get this from Supabase Dashboard: Project Settings -> Database -> Connection String
# Use the Pooler URI (Session mode port 5432 or Transaction mode port 6543):
#
# URI Example (Session pooler - Recommended for Supabase & Docker):
# DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. Supabase Cloud Storage (For persistent product & founder photos)
# ------------------------------------------------------------------------------
# In Supabase Dashboard -> Storage:
# 1. Create a new Bucket named "tjpork-images"
# 2. Set the bucket to "Public" (so photos can be viewed in the store)
#
# Under Project Settings -> API:
# SUPABASE_URL: Project URL (e.g. https://yourprojectref.supabase.co)
# SUPABASE_KEY: Service Role Key (recommended for server-side uploads)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=tjpork-images