# ==============================================================================
# T&JPork Production Environment Variables (.env)
# Copy this file to .env on your server or local environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Database Connection
# ------------------------------------------------------------------------------
# Get this from Supabase Dashboard: Project Settings -> Database -> Connection String
# You can use either the URI format (port 6543 pooler or 5432 direct) or ADO.NET parameters:
#
# URI Example (Session pooler - Recommended for Supabase):
# DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
#
# Direct Example:
# DATABASE_URL=postgresql://postgres:yourpassword@db.yourprojectref.supabase.co:5432/postgres
#
# Standard Key-Value Example:
# DATABASE_URL=Host=aws-0-eu-central-1.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.yourprojectref;Password=yourpassword;SSL Mode=Require;Trust Server Certificate=true
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. Supabase Cloud Storage (For persistent product & founder photos)
# ------------------------------------------------------------------------------
# In Supabase Dashboard -> Storage:
# 1. Create a new Bucket named "tjpork-images"
# 2. Set the bucket to "Public" (so photos can be viewed in the store)
#
# Under Project Settings -> API:
# SUPABASE_URL: Project URL (e.g. https://yourprojectref.supabase.co)
# SUPABASE_KEY: Service Role Key (recommended for server-side uploads) or Anon Public Key
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=tjpork-images
