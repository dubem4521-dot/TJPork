@{
    ViewData["Title"] = "Access Denied";
}

<div class="container" style="margin-top: 140px; margin-bottom: 80px; text-align: center;">
    <div class="tjp-card" style="max-width: 500px; margin: 0 auto; padding: 48px;">
        <div style="width: 72px; height: 72px; border-radius: var(--radius-full); background: var(--danger-light); color: var(--danger); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; font-size: 2rem;">
            <i class="fa-solid fa-hand"></i>
        </div>
        <h1 style="font-size: 1.8rem; margin-bottom: 8px;">Access Denied</h1>
        <p style="color: var(--text-secondary); margin-bottom: 24px;">You do not have administrative privileges to access this section.</p>
        <a asp-controller="Home" asp-action="Index" class="tjp-btn tjp-btn-primary">Return to Storefront</a>
    </div>
</div>
