@model TJPork.Web.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password - T&JPork";
}

<div class="container" style="margin-top: 120px; margin-bottom: 80px;">
    <div class="tjp-card" style="max-width: 480px; margin: 0 auto; padding: 40px;">
        <div style="text-align: center; margin-bottom: 28px;">
            <div style="width: 56px; height: 56px; border-radius: var(--radius-full); background: var(--accent-orange-light); color: var(--accent-orange); display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; font-size: 1.5rem; box-shadow: var(--shadow-raised-sm);">
                <i class="fa-solid fa-key"></i>
            </div>
            <h1 style="font-size: 1.8rem; margin-bottom: 6px;">Reset Your Password</h1>
            <p style="color: var(--text-secondary); font-size: 0.92rem;">Enter your registered email address and we'll send you secure instructions to reset your password.</p>
        </div>

        @if (ViewBag.Submitted == true)
        {
            <div style="background: #ECFDF5; border: 1px solid #A7F3D0; color: #065F46; padding: 18px 20px; border-radius: var(--radius-md); font-size: 0.92rem; margin-bottom: 24px; text-align: center;">
                <div style="font-weight: 700; font-size: 1.05rem; margin-bottom: 6px;">
                    <i class="fa-solid fa-paper-plane" style="color: var(--accent-green); margin-right: 6px;"></i> Check Your Inbox
                </div>
                If an account exists with that email address, password reset instructions have been sent via Brevo. Please check your spam folder if it doesn't appear shortly.
            </div>

            <div style="text-align: center; margin-top: 20px;">
                <a asp-action="Login" class="tjp-btn tjp-btn-primary" style="width: 100%;">
                    <i class="fa-solid fa-arrow-left"></i> Return to Sign In
                </a>
            </div>
        }
        else
        {
            <form asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" style="color: var(--danger); font-size: 0.88rem; margin-bottom: 16px;"></div>

                <div class="tjp-input-group" style="margin-bottom: 24px;">
                    <label asp-for="Email" class="tjp-label"></label>
                    <input asp-for="Email" class="tjp-input" placeholder="e.g. max@tjpork.com" autofocus />
                    <span asp-validation-for="Email" style="color: var(--danger); font-size: 0.8rem;"></span>
                </div>

                <button type="submit" class="tjp-btn tjp-btn-primary" style="width: 100%; font-size: 1.05rem; margin-bottom: 20px;">
                    <i class="fa-solid fa-envelope"></i> Send Password Reset Link
                </button>

                <div style="text-align: center; font-size: 0.9rem; color: var(--text-secondary);">
                    Remembered your password?
                    <a asp-action="Login" style="color: var(--accent-orange); font-weight: 700;">Back to Sign In</a>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
