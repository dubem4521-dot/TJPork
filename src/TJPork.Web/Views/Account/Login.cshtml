@model TJPork.Web.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Customer Sign In - T&JPork";
}

<div class="container" style="margin-top: 120px; margin-bottom: 80px;">
    <div class="tjp-card" style="max-width: 460px; margin: 0 auto; padding: 40px;">
        <div style="text-align: center; margin-bottom: 28px;">
            <div style="width: 56px; height: 56px; border-radius: var(--radius-full); background: var(--accent-orange-light); color: var(--accent-orange); display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; font-size: 1.5rem; box-shadow: var(--shadow-raised-sm);">
                <i class="fa-solid fa-user-lock"></i>
            </div>
            <h1 style="font-size: 1.8rem; margin-bottom: 6px;">Customer Sign In</h1>
            <p style="color: var(--text-secondary); font-size: 0.92rem;">Access your past pork orders, tracking, and saved addresses.</p>
        </div>

        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />

            <div asp-validation-summary="ModelOnly" style="color: var(--danger); font-size: 0.88rem; margin-bottom: 16px;"></div>

            <div class="tjp-input-group">
                <label asp-for="Email" class="tjp-label"></label>
                <input asp-for="Email" class="tjp-input" placeholder="e.g. customer@tjpork.com" />
                <span asp-validation-for="Email" style="color: var(--danger); font-size: 0.8rem;"></span>
            </div>

            <div class="tjp-input-group">
                <label asp-for="Password" class="tjp-label"></label>
                <input asp-for="Password" class="tjp-input" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;" />
                <span asp-validation-for="Password" style="color: var(--danger); font-size: 0.8rem;"></span>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; font-size: 0.88rem;">
                <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                    <input type="checkbox" asp-for="RememberMe" style="accent-color: var(--accent-orange);" />
                    <span>Remember me</span>
                </label>
                <a href="javascript:void(0)" onclick="alert('Demo reset instructions sent to your email.')" style="color: var(--accent-orange); font-weight: 600;">Forgot Password?</a>
            </div>

            <button type="submit" class="tjp-btn tjp-btn-primary" style="width: 100%; font-size: 1.05rem; margin-bottom: 20px;">
                <i class="fa-solid fa-arrow-right-to-bracket"></i> Sign In
            </button>

            <div style="text-align: center; font-size: 0.9rem; color: var(--text-secondary);">
                Don't have an account yet?
                <a asp-action="Register" style="color: var(--accent-orange); font-weight: 700;">Create Account</a>
            </div>

            <div style="margin-top: 24px; padding: 12px; background: var(--bg-surface); border-radius: var(--radius-sm); font-size: 0.8rem; color: var(--text-muted); text-align: center;">
                Demo Customer: <strong>customer@tjpork.com</strong> / <strong>Customer2026!#Pork</strong>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
