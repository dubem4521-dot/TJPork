@model TJPork.Web.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Customer Account - T&JPork";
}

<div class="container" style="margin-top: 110px; margin-bottom: 80px;">
    <div class="tjp-card" style="max-width: 560px; margin: 0 auto; padding: 40px;">
        <div style="text-align: center; margin-bottom: 28px;">
            <div style="width: 56px; height: 56px; border-radius: var(--radius-full); background: var(--accent-orange-light); color: var(--accent-orange); display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; font-size: 1.5rem; box-shadow: var(--shadow-raised-sm);">
                <i class="fa-solid fa-user-plus"></i>
            </div>
            <h1 style="font-size: 1.9rem; margin-bottom: 6px;">Join the T&amp;JPork Club</h1>
            <p style="color: var(--text-secondary); font-size: 0.92rem;">Enjoy seamless ordering, real-time butcher tracking, and loyalty rewards.</p>
        </div>

        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" style="color: var(--danger); font-size: 0.88rem; margin-bottom: 16px;"></div>

            <div class="tjp-input-group">
                <label asp-for="FullName" class="tjp-label"></label>
                <input asp-for="FullName" class="tjp-input" placeholder="e.g. Eleanor Vance" />
                <span asp-validation-for="FullName" style="color: var(--danger); font-size: 0.8rem;"></span>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <div class="tjp-input-group">
                    <label asp-for="Email" class="tjp-label"></label>
                    <input asp-for="Email" class="tjp-input" placeholder="eleanor@example.com" />
                    <span asp-validation-for="Email" style="color: var(--danger); font-size: 0.8rem;"></span>
                </div>

                <div class="tjp-input-group">
                    <label asp-for="PhoneNumber" class="tjp-label"></label>
                    <input asp-for="PhoneNumber" class="tjp-input" placeholder="+1 (555) 019-2834" />
                    <span asp-validation-for="PhoneNumber" style="color: var(--danger); font-size: 0.8rem;"></span>
                </div>
            </div>

            <div class="tjp-input-group">
                <label asp-for="DeliveryAddress" class="tjp-label"></label>
                <input asp-for="DeliveryAddress" class="tjp-input" placeholder="Street name and unit number" />
                <span asp-validation-for="DeliveryAddress" style="color: var(--danger); font-size: 0.8rem;"></span>
            </div>

            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 16px;">
                <div class="tjp-input-group">
                    <label asp-for="City" class="tjp-label"></label>
                    <input asp-for="City" class="tjp-input" placeholder="Austin" />
                    <span asp-validation-for="City" style="color: var(--danger); font-size: 0.8rem;"></span>
                </div>

                <div class="tjp-input-group">
                    <label asp-for="PostalCode" class="tjp-label"></label>
                    <input asp-for="PostalCode" class="tjp-input" placeholder="78701" />
                    <span asp-validation-for="PostalCode" style="color: var(--danger); font-size: 0.8rem;"></span>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <div class="tjp-input-group">
                    <label asp-for="Password" class="tjp-label"></label>
                    <input asp-for="Password" class="tjp-input tjp-password-input" placeholder="Min 6 characters" />
                    <span asp-validation-for="Password" style="color: var(--danger); font-size: 0.8rem;"></span>
                </div>

                <div class="tjp-input-group">
                    <label asp-for="ConfirmPassword" class="tjp-label"></label>
                    <input asp-for="ConfirmPassword" class="tjp-input" placeholder="Repeat password" />
                    <span asp-validation-for="ConfirmPassword" style="color: var(--danger); font-size: 0.8rem;"></span>
                </div>
            </div>

            <!-- Real-time Password Strength Meter -->
            <div style="margin-bottom: 24px;">
                <div style="display: flex; justify-content: space-between; font-size: 0.82rem; margin-bottom: 6px;">
                    <span style="color: var(--text-secondary);">Password Strength:</span>
                    <span class="tjp-strength-text" style="font-weight: 600; color: var(--text-muted);">Enter password</span>
                </div>
                <div style="height: 6px; background: #E2E8F0; border-radius: 3px; overflow: hidden;">
                    <div class="tjp-strength-bar" style="width: 0%; height: 100%; transition: width 0.3s ease, background-color 0.3s ease;"></div>
                </div>
            </div>

            <button type="submit" class="tjp-btn tjp-btn-primary" style="width: 100%; font-size: 1.05rem; margin-bottom: 20px;">
                <i class="fa-solid fa-user-check"></i> Register Account
            </button>

            <div style="text-align: center; font-size: 0.9rem; color: var(--text-secondary);">
                Already have an account?
                <a asp-action="Login" style="color: var(--accent-orange); font-weight: 700;">Sign In</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
