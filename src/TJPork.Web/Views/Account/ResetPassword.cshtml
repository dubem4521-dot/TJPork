@model TJPork.Web.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Set New Password - T&JPork";
}

<div class="container" style="margin-top: 120px; margin-bottom: 80px;">
    <div class="tjp-card" style="max-width: 480px; margin: 0 auto; padding: 40px;">
        <div style="text-align: center; margin-bottom: 28px;">
            <div style="width: 56px; height: 56px; border-radius: var(--radius-full); background: var(--accent-orange-light); color: var(--accent-orange); display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; font-size: 1.5rem; box-shadow: var(--shadow-raised-sm);">
                <i class="fa-solid fa-lock-open"></i>
            </div>
            <h1 style="font-size: 1.8rem; margin-bottom: 6px;">Set New Password</h1>
            <p style="color: var(--text-secondary); font-size: 0.92rem;">Enter your new password below for <strong>@Model.Email</strong>.</p>
        </div>

        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Email" />

            <div asp-validation-summary="ModelOnly" style="color: var(--danger); font-size: 0.88rem; margin-bottom: 16px;"></div>

            <div class="tjp-input-group">
                <label asp-for="Password" class="tjp-label"></label>
                <input asp-for="Password" class="tjp-input" placeholder="At least 8 characters" />
                <span asp-validation-for="Password" style="color: var(--danger); font-size: 0.8rem;"></span>
            </div>

            <div class="tjp-input-group" style="margin-bottom: 24px;">
                <label asp-for="ConfirmPassword" class="tjp-label"></label>
                <input asp-for="ConfirmPassword" class="tjp-input" placeholder="Repeat your new password" />
                <span asp-validation-for="ConfirmPassword" style="color: var(--danger); font-size: 0.8rem;"></span>
            </div>

            <button type="submit" class="tjp-btn tjp-btn-primary" style="width: 100%; font-size: 1.05rem; margin-bottom: 20px;">
                <i class="fa-solid fa-check"></i> Save New Password
            </button>

            <div style="text-align: center; font-size: 0.9rem; color: var(--text-secondary);">
                Back to
                <a asp-action="Login" style="color: var(--accent-orange); font-weight: 700;">Customer Sign In</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
