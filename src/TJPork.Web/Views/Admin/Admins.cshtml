@model TJPork.Web.ViewModels.AdminUserListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Administrator Team";
}

<!-- Top Action Header -->
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
    <div>
        <p style="color: var(--text-secondary); margin: 0;">Manage store owners, butchery managers, and users with administrative access.</p>
    </div>
    <a asp-action="CreateAdmin" class="tjp-btn tjp-btn-primary">
        <i class="fa-solid fa-user-plus"></i> Add New Administrator
    </a>
</div>

<!-- Admins Table Card -->
<div class="tjp-card" style="padding: 0; overflow: hidden;">
    <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
            <thead>
                <tr style="background: #FFFFFF; border-bottom: 1px solid #EEF2F6; color: var(--text-secondary); font-size: 0.82rem;">
                    <th style="padding: 14px 20px;">Administrator</th>
                    <th style="padding: 14px 20px;">Contact Email</th>
                    <th style="padding: 14px 20px;">Phone</th>
                    <th style="padding: 14px 20px;">Date Appointed</th>
                    <th style="padding: 14px 20px;">Access Level</th>
                    <th style="padding: 14px 20px; text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var admin in Model.Admins)
                {
                    <tr style="border-bottom: 1px solid #F1F5F9;">
                        <td style="padding: 14px 20px; display: flex; align-items: center; gap: 12px;">
                            <img src="@admin.AvatarUrl" alt="@admin.FullName" style="width: 42px; height: 42px; border-radius: var(--radius-full); object-fit: cover; border: 2px solid var(--accent-orange);" onerror="this.src='/images/avatars/default.png'" />
                            <div>
                                <strong style="color: var(--text-primary); display: block; font-size: 0.95rem;">@admin.FullName</strong>
                                @if (admin.IsCurrentAdmin)
                                {
                                    <span class="tjp-badge" style="position: static; font-size: 0.72rem; background: var(--accent-orange); color: #FFF;">You (Active Session)</span>
                                }
                            </div>
                        </td>
                        <td style="padding: 14px 20px;">
                            <span class="mono" style="color: var(--text-primary);">@admin.Email</span>
                        </td>
                        <td style="padding: 14px 20px; color: var(--text-secondary);">
                            @(string.IsNullOrWhiteSpace(admin.PhoneNumber) ? "—" : admin.PhoneNumber)
                        </td>
                        <td style="padding: 14px 20px; color: var(--text-muted); font-size: 0.85rem;">
                            @(admin.CreatedAt == default ? "Seed Master" : admin.CreatedAt.ToString("MMM dd, yyyy"))
                        </td>
                        <td style="padding: 14px 20px;">
                            <span class="tjp-chip" style="font-size: 0.8rem; background: var(--bg-surface);"><i class="fa-solid fa-shield-halved" style="color: var(--accent-orange);"></i> Full Administrator</span>
                        </td>
                        <td style="padding: 14px 20px; text-align: right;">
                            @if (!admin.IsCurrentAdmin)
                            {
                                <form asp-action="RemoveAdmin" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to remove administrator access for @admin.FullName?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@admin.Id" />
                                    <button type="submit" class="tjp-btn tjp-btn-neu tjp-btn-sm" style="color: var(--danger); padding: 6px 12px;" title="Revoke Admin Access">
                                        <i class="fa-solid fa-user-xmark"></i> Remove Admin
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a asp-action="Profile" class="tjp-btn tjp-btn-neu tjp-btn-sm" style="padding: 6px 12px;">
                                    <i class="fa-solid fa-user-pen"></i> Edit Profile
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
