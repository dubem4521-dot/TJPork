@model TJPork.Web.ViewModels.AdminDashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Overview Analytics";
}

<!-- Top KPI Stats Row -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 32px;">
    <!-- Today's Orders -->
    <div class="tjp-metric-card">
        <div>
            <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600;">Today's Orders</div>
            <div class="mono" style="font-size: 1.8rem; font-weight: 800; color: var(--text-primary);">@Model.Summary.TodayOrdersCount</div>
            <div style="font-size: 0.78rem; color: var(--accent-orange); font-weight: 600; margin-top: 4px;">R@(Model.Summary.TodayRevenue.ToString("F2")) today</div>
        </div>
        <div class="tjp-metric-icon" style="background: var(--accent-orange-light); color: var(--accent-orange);">
            <i class="fa-solid fa-receipt"></i>
        </div>
    </div>

    <!-- Monthly Revenue -->
    <div class="tjp-metric-card">
        <div>
            <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600;">Monthly Revenue</div>
            <div class="mono" style="font-size: 1.8rem; font-weight: 800; color: var(--accent-green);">R@(Model.Summary.MonthRevenue.ToString("F2"))</div>
            <div style="font-size: 0.78rem; color: var(--text-secondary); margin-top: 4px;">Week: R@(Model.Summary.WeekRevenue.ToString("F2"))</div>
        </div>
        <div class="tjp-metric-icon" style="background: var(--accent-green-light); color: var(--accent-green);">
            <i class="fa-solid fa-sack-dollar"></i>
        </div>
    </div>

    <!-- Total Customers -->
    <div class="tjp-metric-card">
        <div>
            <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600;">Active Customers</div>
            <div class="mono" style="font-size: 1.8rem; font-weight: 800; color: #3498DB;">@Model.Summary.TotalCustomers</div>
            <div style="font-size: 0.78rem; color: var(--text-secondary); margin-top: 4px;">Avg Order: R@(Model.Summary.AverageOrderValue.ToString("F2"))</div>
        </div>
        <div class="tjp-metric-icon" style="background: #EBF5FB; color: #3498DB;">
            <i class="fa-solid fa-users"></i>
        </div>
    </div>

    <!-- Low Stock Alert -->
    <div class="tjp-metric-card">
        <div>
            <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600;">Low Stock Warnings</div>
            <div class="mono" style="font-size: 1.8rem; font-weight: 800; color: @(Model.Summary.LowStockCount > 0 ? "var(--danger)" : "var(--accent-green)");">@Model.Summary.LowStockCount</div>
            <div style="font-size: 0.78rem; color: var(--text-secondary); margin-top: 4px;">@(Model.Summary.LowStockCount > 0 ? "Replenishment needed" : "Inventory healthy")</div>
        </div>
        <div class="tjp-metric-icon" style="background: var(--danger-light); color: var(--danger);">
            <i class="fa-solid fa-boxes-stacked"></i>
        </div>
    </div>
</div>

<!-- Charts Section: 30-Day Sales & Category Doughnut -->
<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px; margin-bottom: 32px;">
    <!-- Line Chart: 30-Day Revenue -->
    <div class="tjp-card" style="padding: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <div>
                <h3 style="font-size: 1.15rem; margin-bottom: 4px;">Sales Revenue (Last 30 Days)</h3>
                <p style="font-size: 0.85rem; color: var(--text-secondary);">Daily revenue tracking across all customer orders</p>
            </div>
            <span class="tjp-chip" style="background: var(--bg-surface);"><i class="fa-solid fa-chart-line" style="color: var(--accent-orange);"></i> Live Data</span>
        </div>
        <div style="height: 280px; position: relative;">
            <canvas id="salesChartCanvas"></canvas>
        </div>
    </div>

    <!-- Doughnut Chart: Category Share -->
    <div class="tjp-card" style="padding: 24px;">
        <div style="margin-bottom: 16px;">
            <h3 style="font-size: 1.15rem; margin-bottom: 4px;">Category Share</h3>
            <p style="font-size: 0.85rem; color: var(--text-secondary);">Revenue by pork category</p>
        </div>
        <div style="height: 280px; position: relative;">
            <canvas id="categoryChartCanvas"></canvas>
        </div>
    </div>
</div>

<!-- Tables Section: Top Products & Recent Orders -->
<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
    <!-- Top 5 Products -->
    <div class="tjp-card" style="padding: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
            <h3 style="font-size: 1.15rem;"><i class="fa-solid fa-fire" style="color: var(--accent-orange); margin-right: 8px;"></i> Best-Selling Cuts</h3>
            <a asp-action="Products" style="font-size: 0.85rem; color: var(--accent-orange); font-weight: 600;">Manage All</a>
        </div>

        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
                <thead>
                    <tr style="border-bottom: 1px solid #EEF2F6; color: var(--text-secondary); text-align: left; font-size: 0.82rem;">
                        <th style="padding: 8px 0;">Product</th>
                        <th style="padding: 8px 0; text-align: center;">Units Sold</th>
                        <th style="padding: 8px 0; text-align: right;">Revenue</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var prod in Model.Summary.TopSellingProducts)
                    {
                        <tr style="border-bottom: 1px solid #F1F5F9;">
                            <td style="padding: 10px 0; display: flex; align-items: center; gap: 10px;">
                                <img src="@prod.ImageUrl" alt="@prod.ProductName" style="width: 36px; height: 36px; border-radius: 4px; object-fit: cover;" onerror="this.src='/images/products/placeholder.jpg'" />
                                <div>
                                    <div style="font-weight: 600; color: var(--text-primary);">@prod.ProductName</div>
                                    <div style="font-size: 0.78rem; color: var(--text-muted);">@prod.CategoryName</div>
                                </div>
                            </td>
                            <td style="padding: 10px 0; text-align: center;" class="mono">@prod.UnitsSold</td>
                            <td style="padding: 10px 0; text-align: right; font-weight: 700; color: var(--accent-green);" class="mono">R@(prod.TotalRevenue.ToString("F2"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Recent Orders -->
    <div class="tjp-card" style="padding: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
            <h3 style="font-size: 1.15rem;"><i class="fa-solid fa-clock-rotate-left" style="color: #3498DB; margin-right: 8px;"></i> Recent Orders</h3>
            <a asp-action="Orders" style="font-size: 0.85rem; color: var(--accent-orange); font-weight: 600;">View All</a>
        </div>

        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
                <thead>
                    <tr style="border-bottom: 1px solid #EEF2F6; color: var(--text-secondary); text-align: left; font-size: 0.82rem;">
                        <th style="padding: 8px 0;">Order #</th>
                        <th style="padding: 8px 0;">Customer</th>
                        <th style="padding: 8px 0; text-align: right;">Total</th>
                        <th style="padding: 8px 0; text-align: center;">Status</th>
                        <th style="padding: 8px 0; text-align: right;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ord in Model.RecentOrders)
                    {
                        <tr style="border-bottom: 1px solid #F1F5F9;">
                            <td style="padding: 10px 0;" class="mono"><strong style="color: var(--accent-orange);">#@ord.OrderNumber</strong></td>
                            <td style="padding: 10px 0; color: var(--text-primary);">@ord.CustomerName</td>
                            <td style="padding: 10px 0; text-align: right;" class="mono">R@(ord.TotalAmount.ToString("F2"))</td>
                            <td style="padding: 10px 0; text-align: center;">
                                <span class="tjp-badge" style="position: static; font-size: 0.72rem; background: @(ord.DeliveryStatus == OrderStatus.Delivered ? "var(--accent-green)" : "var(--accent-orange)");">
                                    @ord.DeliveryStatus
                                </span>
                            </td>
                            <td style="padding: 10px 0; text-align: right;">
                                <button type="button" class="tjp-btn tjp-btn-neu tjp-btn-sm view-order-btn" data-order-id="@ord.Id" style="padding: 4px 8px; font-size: 0.75rem;">
                                    View
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const salesLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Summary.Last30DaysSales.Select(s => s.Date)));
            const salesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Summary.Last30DaysSales.Select(s => s.Revenue)));

            const catLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Summary.CategoryBreakdown.Select(c => c.CategoryName)));
            const catData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Summary.CategoryBreakdown.Select(c => c.Revenue)));

            initSalesChart('salesChartCanvas', salesLabels, salesData);
            initCategoryDoughnutChart('categoryChartCanvas', catLabels, catData);
        });
    </script>
}
