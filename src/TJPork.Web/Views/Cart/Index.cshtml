@model TJPork.Web.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Shopping Cart - T&JPork";
}

<div class="container" style="margin-top: 110px; margin-bottom: 80px;">
    <div style="margin-bottom: 32px;">
        <span style="color: var(--accent-orange); font-weight: 700; font-size: 0.85rem; text-transform: uppercase;">Review Your Selections</span>
        <h1 style="font-size: 2.4rem; margin-top: 4px;">Artisanal Pork Cart</h1>
    </div>

    @if (Model.Cart.Items.Count == 0)
    {
        <div class="tjp-card" style="text-align: center; padding: 60px 20px;">
            <div style="width: 80px; height: 80px; border-radius: var(--radius-full); background: var(--bg-surface); color: var(--text-muted); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; font-size: 2rem; box-shadow: var(--shadow-raised-sm);">
                <i class="fa-solid fa-cart-shopping"></i>
            </div>
            <h2 style="font-size: 1.5rem; margin-bottom: 8px;">Your cart is currently empty</h2>
            <p style="color: var(--text-secondary); max-width: 480px; margin: 0 auto 24px;">Explore our handcrafted sausages, thick-cut bacon, and heritage pork chops ready for your kitchen.</p>
            <a asp-controller="Shop" asp-action="Index" class="tjp-btn tjp-btn-primary tjp-btn-lg">
                <i class="fa-solid fa-drumstick-bite"></i> Explore Pork Catalog
            </a>
        </div>
    }
    else
    {
        <div style="display: grid; grid-template-columns: 1fr 380px; gap: 36px; align-items: start;">
            <!-- Left: Items Table -->
            <div>
                <!-- Free Shipping Progress -->
                <div class="tjp-card" style="padding: 16px 20px; margin-bottom: 24px; background: var(--bg-surface); box-shadow: var(--shadow-inset-sm);">
                    @if (Model.Cart.Subtotal >= Model.FreeShippingThreshold)
                    {
                        <div style="display: flex; align-items: center; gap: 10px; color: var(--accent-green); font-weight: 700; font-size: 0.95rem;">
                            <i class="fa-solid fa-circle-check fa-lg"></i>
                            <span>Congratulations! Your order qualifies for <strong>FREE Cold-Chain Delivery</strong>!</span>
                        </div>
                    }
                    else
                    {
                        <div style="display: flex; justify-content: space-between; font-size: 0.9rem; margin-bottom: 8px; color: var(--text-secondary);">
                            <span>Add <strong style="color: var(--accent-orange);">R@(Model.AmountNeededForFreeShipping.ToString("F2"))</strong> more to unlock <strong>Free Delivery</strong></span>
                            <span>R@(Model.Cart.Subtotal.ToString("F2")) / R@(Model.FreeShippingThreshold.ToString("F2"))</span>
                        </div>
                        <div style="height: 8px; background: #E2E8F0; border-radius: 4px; overflow: hidden;">
                            <div style="width: @Model.FreeShippingProgressPercent%; height: 100%; background: linear-gradient(90deg, #E67E22, #27AE60); transition: width 0.4s ease;"></div>
                        </div>
                    }
                </div>

                <!-- Item Cards -->
                <div class="tjp-card" style="padding: 0; overflow: hidden;">
                    <div style="padding: 18px 24px; background: var(--bg-surface); border-bottom: 1px solid #EEF2F6; font-weight: 700; font-size: 0.9rem; color: var(--text-secondary); display: grid; grid-template-columns: 2fr 1fr 1fr 1fr 40px; gap: 12px; align-items: center;">
                        <span>Product</span>
                        <span>Unit Price</span>
                        <span>Quantity</span>
                        <span style="text-align: right;">Total</span>
                        <span></span>
                    </div>

                    <div style="padding: 12px 24px;">
                        @foreach (var item in Model.Cart.Items)
                        {
                            <div style="display: grid; grid-template-columns: 2fr 1fr 1fr 1fr 40px; gap: 12px; align-items: center; padding: 18px 0; border-bottom: 1px solid #F1F5F9;">
                                <!-- Product info -->
                                <div style="display: flex; align-items: center; gap: 14px;">
                                    <img src="@item.ImageUrl" alt="@item.ProductName" style="width: 64px; height: 64px; border-radius: var(--radius-sm); object-fit: cover;" onerror="this.src='/images/products/placeholder.jpg'" />
                                    <div>
                                        <h4 style="font-size: 0.98rem; margin-bottom: 2px;"><a asp-controller="Shop" asp-action="Details" asp-route-slug="@item.ProductSlug">@item.ProductName</a></h4>
                                        <span style="font-size: 0.8rem; color: var(--text-muted);">@item.WeightDescription</span>
                                    </div>
                                </div>

                                <!-- Unit Price -->
                                <div class="mono" style="font-size: 0.95rem; color: var(--text-secondary);">R@(item.UnitPrice.ToString("F2"))</div>

                                <!-- Quantity Stepper -->
                                <div>
                                    <div class="tjp-quantity-stepper">
                                        <button type="button" class="tjp-qty-btn" onclick="updateCartQuantityAjax(@item.ProductId, @(item.Quantity - 1))">-</button>
                                        <span class="tjp-qty-val">@item.Quantity</span>
                                        <button type="button" class="tjp-qty-btn" onclick="updateCartQuantityAjax(@item.ProductId, @(item.Quantity + 1))">+</button>
                                    </div>
                                </div>

                                <!-- Total -->
                                <div class="mono" style="font-size: 1.05rem; font-weight: 700; text-align: right; color: var(--text-primary);">R@(item.TotalPrice.ToString("F2"))</div>

                                <!-- Remove -->
                                <div style="text-align: center;">
                                    <button type="button" onclick="removeCartItemAjax(@item.ProductId)" style="background: transparent; border: none; color: var(--text-muted); cursor: pointer; font-size: 0.95rem;" title="Remove">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right: Summary Box -->
            <div class="tjp-card" style="padding: 28px; position: sticky; top: 96px;">
                <h3 style="font-size: 1.3rem; margin-bottom: 20px; border-bottom: 1px solid #EEF2F6; padding-bottom: 12px;">Order Summary</h3>

                <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 20px;">
                    <div style="display: flex; justify-content: space-between; font-size: 0.95rem; color: var(--text-secondary);">
                        <span>Subtotal (@Model.Cart.TotalItemCount items):</span>
                        <span class="mono" style="font-weight: 600; color: var(--text-primary);">R@(Model.Cart.Subtotal.ToString("F2"))</span>
                    </div>

                    <div style="display: flex; justify-content: space-between; font-size: 0.95rem; color: var(--text-secondary);">
                        <span>Chilled Delivery:</span>
                        <span class="mono" style="font-weight: 600; color: @(Model.Cart.DeliveryFee == 0 ? "var(--accent-green)" : "var(--text-primary)");">
                            @(Model.Cart.DeliveryFee == 0 ? "FREE" : "R" + Model.Cart.DeliveryFee.ToString("F2"))
                        </span>
                    </div>

                    <div style="display: flex; justify-content: space-between; font-size: 0.95rem; color: var(--text-secondary);">
                        <span>VAT (15%):</span>
                        <span class="mono" style="font-weight: 600; color: var(--text-primary);">R@(Model.Cart.TaxAmount.ToString("F2"))</span>
                    </div>

                    @if (Model.Cart.DiscountAmount > 0)
                    {
                        <div style="display: flex; justify-content: space-between; font-size: 0.95rem; color: var(--accent-green); font-weight: 600;">
                            <span>Promo Discount:</span>
                            <span class="mono">-R@(Model.Cart.DiscountAmount.ToString("F2"))</span>
                        </div>
                    }

                    <div style="display: flex; justify-content: space-between; font-size: 1.3rem; font-weight: 800; border-top: 1px solid #E2E8F0; padding-top: 14px; margin-top: 6px; color: var(--text-primary);">
                        <span>Total:</span>
                        <span class="mono" style="color: var(--accent-orange);">R@(Model.Cart.Total.ToString("F2"))</span>
                    </div>
                </div>

                <!-- Promo Code Form -->
                <form asp-controller="Cart" asp-action="ApplyCoupon" method="post" style="margin-bottom: 24px;">
                    <label class="tjp-label" style="font-size: 0.85rem;">Promo / Discount Code</label>
                    <div style="display: flex; gap: 8px;">
                        <input type="text" name="couponCode" class="tjp-input" placeholder="e.g. PORK10, TJPORK50, FREESHIP" style="padding: 8px 12px; font-size: 0.88rem;" />
                        <button type="submit" class="tjp-btn tjp-btn-neu tjp-btn-sm" style="white-space: nowrap;">Apply</button>
                    </div>
                    @if (TempData["CouponError"] != null)
                    {
                        <span style="color: var(--danger); font-size: 0.78rem; display: block; margin-top: 4px;">@TempData["CouponError"]</span>
                    }
                    @if (TempData["CouponSuccess"] != null)
                    {
                        <span style="color: var(--accent-green); font-weight: 600; font-size: 0.78rem; display: block; margin-top: 4px;">@TempData["CouponSuccess"]</span>
                    }
                </form>

                <a asp-controller="Checkout" asp-action="Index" class="tjp-btn tjp-btn-primary tjp-btn-lg" style="width: 100%; font-size: 1.05rem;">
                    <span>Proceed to Checkout</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </a>

                <div style="margin-top: 18px; text-align: center; font-size: 0.82rem; color: var(--text-muted); display: flex; align-items: center; justify-content: center; gap: 6px;">
                    <i class="fa-solid fa-lock" style="color: var(--accent-green);"></i>
                    <span>Secure 256-bit Encrypted Checkout</span>
                </div>
            </div>
        </div>
    }
</div>
