@model TJPork.Web.ViewModels.OrderConfirmationViewModel
@{
    ViewData["Title"] = $"Order Confirmed #{Model.OrderNumber} - T&JPork";
}

<div class="container" style="margin-top: 110px; margin-bottom: 80px;">
    <div class="tjp-card" style="max-width: 780px; margin: 0 auto; padding: 48px 36px; text-align: center;">
        <!-- Success Icon -->
        <div style="width: 80px; height: 80px; border-radius: var(--radius-full); background: var(--accent-green-light); color: var(--accent-green); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; font-size: 2.2rem; box-shadow: var(--shadow-raised-sm);">
            <i class="fa-solid fa-check"></i>
        </div>

        <span style="color: var(--accent-green); font-weight: 700; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.05em;">Order Placed Successfully!</span>
        <h1 style="font-size: 2.4rem; margin: 6px 0 16px;">Thank You, @Model.CustomerName!</h1>
        <p style="font-size: 1.1rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 28px;">
            Your order <strong style="color: var(--accent-orange); font-family: var(--font-mono);">#@Model.OrderNumber</strong> has been received and routed to our smokehouse butcher station.
        </p>

        <!-- Notification Banner -->
        <div style="background: var(--bg-surface); padding: 18px 24px; border-radius: var(--radius-md); box-shadow: var(--shadow-inset-sm); margin-bottom: 32px; text-align: left; display: flex; gap: 16px; align-items: center;">
            <i class="fa-solid fa-envelope-circle-check fa-2x" style="color: var(--accent-orange);"></i>
            <div style="font-size: 0.92rem; color: var(--text-secondary);">
                <strong style="color: var(--text-primary); display: block; margin-bottom: 2px;">Email Notifications Dispatched</strong>
                A confirmation receipt has been emailed to <strong style="color: var(--text-primary);">@Model.CustomerEmail</strong>, and an order alert has been sent to founders Tinashe &amp; Jeffery.
            </div>
        </div>

        <!-- Order Summary Card -->
        <div style="background: #FFFFFF; border: 1px solid #EEF2F6; border-radius: var(--radius-md); padding: 24px; text-align: left; margin-bottom: 32px;">
            <h3 style="font-size: 1.15rem; margin-bottom: 16px; border-bottom: 1px solid #F1F5F9; padding-bottom: 10px;">
                <i class="fa-solid fa-truck-ramp-box" style="color: var(--accent-orange); margin-right: 8px;"></i> Fulfillment Details
            </h3>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                <div>
                    <span style="font-size: 0.82rem; color: var(--text-muted); display: block;">Estimated Delivery</span>
                    <strong style="font-size: 0.98rem; color: var(--text-primary);">@Model.DeliveryDate.ToString("dddd, MMMM dd, yyyy")</strong>
                    <span style="display: block; font-size: 0.85rem; color: var(--text-secondary);">Slot: @Model.DeliverySlot</span>
                </div>
                <div>
                    <span style="font-size: 0.82rem; color: var(--text-muted); display: block;">Delivery Address</span>
                    <strong style="font-size: 0.98rem; color: var(--text-primary);">@Model.ShippingAddress</strong>
                    <span style="display: block; font-size: 0.85rem; color: var(--text-secondary);">@Model.City, @Model.PostalCode</span>
                </div>
            </div>

            <!-- Items Purchased -->
            <h4 style="font-size: 0.95rem; margin-bottom: 10px; color: var(--text-secondary);">Items Ordered</h4>
            <div style="display: flex; flex-direction: column; gap: 10px; border-top: 1px solid #F1F5F9; padding-top: 10px;">
                @foreach (var item in Model.Items)
                {
                    <div style="display: flex; justify-content: space-between; font-size: 0.92rem;">
                        <span>@item.ProductName &times; @item.Quantity</span>
                        <span class="mono" style="font-weight: 600;">R@(item.TotalPrice.ToString("F2"))</span>
                    </div>
                }
                <div style="display: flex; justify-content: space-between; font-size: 1.15rem; font-weight: 800; border-top: 1px solid #E2E8F0; padding-top: 10px; margin-top: 6px;">
                    <span>Total Paid / Due:</span>
                    <span class="mono" style="color: var(--accent-orange);">R@(Model.TotalAmount.ToString("F2"))</span>
                </div>
            </div>
        </div>

        <div style="display: flex; justify-content: center; gap: 16px; flex-wrap: wrap;">
            <a asp-controller="Home" asp-action="Index" class="tjp-btn tjp-btn-primary">
                <i class="fa-solid fa-house"></i> Return to Storefront
            </a>
            <a asp-controller="Profile" asp-action="Index" class="tjp-btn tjp-btn-neu">
                <i class="fa-solid fa-bag-shopping"></i> Track in My Profile
            </a>
        </div>
    </div>
</div>
