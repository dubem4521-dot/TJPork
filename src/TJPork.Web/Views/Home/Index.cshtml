@model TJPork.Web.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Artisanal Heritage Pork & Smoked Meats";
}

<div class="container">
    <!-- 1. Hero Carousel Section -->
    <section class="tjp-hero-slider">
        @for (int i = 0; i < Model.HeroSlides.Count; i++)
        {
            var slide = Model.HeroSlides[i];
            <div class="tjp-hero-slide @(i == 0 ? "active" : "")" style="background-image: url('@slide.ImageUrl');">
                <div class="tjp-hero-overlay"></div>
                <div class="tjp-hero-content">
                    <span class="tjp-hero-badge"><i class="fa-solid fa-award" style="margin-right: 6px;"></i>@slide.Badge</span>
                    <h1 class="tjp-hero-title">@slide.Title</h1>
                    <h2 class="tjp-hero-subtitle">@slide.Subtitle</h2>
                    <p class="tjp-hero-desc">@slide.Description</p>
                    <div style="display: flex; gap: 14px; flex-wrap: wrap;">
                        <a href="@slide.ButtonUrl" class="tjp-btn tjp-btn-primary tjp-btn-lg">
                            <span>@slide.ButtonText</span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </a>
                        <a asp-controller="Home" asp-action="About" class="tjp-btn tjp-btn-neu tjp-btn-lg" style="background: rgba(255,255,255,0.15); color: #FFFFFF; border-color: rgba(255,255,255,0.3);">
                            <span>Our Story</span>
                        </a>
                    </div>
                </div>
            </div>
        }

        <div class="tjp-hero-controls">
            <button type="button" class="tjp-hero-arrow tjp-hero-prev" title="Previous Slide">
                <i class="fa-solid fa-chevron-left"></i>
            </button>
            <button type="button" class="tjp-hero-arrow tjp-hero-next" title="Next Slide">
                <i class="fa-solid fa-chevron-right"></i>
            </button>
        </div>
    </section>

    <!-- 2. Value Props Bar -->
    <section style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 48px;">
        <div class="tjp-card" style="display: flex; align-items: center; gap: 16px; padding: 20px;">
            <div style="width: 48px; height: 48px; border-radius: var(--radius-full); background: var(--accent-orange-light); color: var(--accent-orange); display: flex; align-items: center; justify-content: center; font-size: 1.3rem;">
                <i class="fa-solid fa-leaf"></i>
            </div>
            <div>
                <h4 style="font-size: 0.95rem; margin-bottom: 2px;">100% Pasture-Raised</h4>
                <p style="font-size: 0.82rem; color: var(--text-secondary);">Ethical heritage family farms</p>
            </div>
        </div>

        <div class="tjp-card" style="display: flex; align-items: center; gap: 16px; padding: 20px;">
            <div style="width: 48px; height: 48px; border-radius: var(--radius-full); background: var(--accent-green-light); color: var(--accent-green); display: flex; align-items: center; justify-content: center; font-size: 1.3rem;">
                <i class="fa-solid fa-fire-burner"></i>
            </div>
            <div>
                <h4 style="font-size: 0.95rem; margin-bottom: 2px;">Small Batch Curing</h4>
                <p style="font-size: 0.82rem; color: var(--text-secondary);">Hardwood smoke, no artificial junk</p>
            </div>
        </div>

        <div class="tjp-card" style="display: flex; align-items: center; gap: 16px; padding: 20px;">
            <div style="width: 48px; height: 48px; border-radius: var(--radius-full); background: #EBF5FB; color: #3498DB; display: flex; align-items: center; justify-content: center; font-size: 1.3rem;">
                <i class="fa-solid fa-truck-fast"></i>
            </div>
            <div>
                <h4 style="font-size: 0.95rem; margin-bottom: 2px;">Chilled Doorstep Delivery</h4>
                <p style="font-size: 0.82rem; color: var(--text-secondary);">Free on orders over R500</p>
            </div>
        </div>

        <div class="tjp-card" style="display: flex; align-items: center; gap: 16px; padding: 20px;">
            <div style="width: 48px; height: 48px; border-radius: var(--radius-full); background: #FEF9E7; color: #F1C40F; display: flex; align-items: center; justify-content: center; font-size: 1.3rem;">
                <i class="fa-solid fa-star"></i>
            </div>
            <div>
                <h4 style="font-size: 0.95rem; margin-bottom: 2px;">Founder Guaranteed</h4>
                <p style="font-size: 0.82rem; color: var(--text-secondary);">Supervised by Tinashe &amp; Jeffery</p>
            </div>
        </div>
    </section>

    <!-- 3. Featured & Filterable Catalog -->
    <section id="catalogSection" style="margin-bottom: 60px;">
        <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
            <div>
                <span style="color: var(--accent-orange); font-weight: 700; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em;">Fresh From the Smokehouse</span>
                <h2 style="font-size: 2.1rem; margin-top: 4px;">Artisanal Pork Selection</h2>
            </div>
            <a asp-controller="Shop" asp-action="Index" class="tjp-btn tjp-btn-neu tjp-btn-sm">
                <span>View Full Catalog</span>
                <i class="fa-solid fa-arrow-right"></i>
            </a>
        </div>

        <!-- Filter Chips & Sort Controls -->
        <div class="tjp-filters-bar">
            <div class="tjp-category-chips">
                <button type="button" class="tjp-chip active filter-category-btn" data-category-id="0">
                    <i class="fa-solid fa-layer-group"></i> All Cuts
                </button>
                @foreach (var cat in Model.Categories)
                {
                    <button type="button" class="tjp-chip filter-category-btn" data-category-id="@cat.Id">
                        <i class="@cat.IconClass"></i> @cat.Name
                    </button>
                }
            </div>

            <div style="display: flex; align-items: center; gap: 12px;">
                <label for="homeSortSelect" style="font-size: 0.88rem; font-weight: 600; color: var(--text-secondary);">Sort:</label>
                <select id="homeSortSelect" class="tjp-select" style="width: auto; padding: 6px 14px; font-size: 0.88rem;">
                    <option value="featured">Featured First</option>
                    <option value="price-low">Price: Low to High</option>
                    <option value="price-high">Price: High to Low</option>
                    <option value="rating">Highest Rated</option>
                </select>
            </div>
        </div>

        <!-- Products Grid -->
        <div class="grid-products" id="homeProductGrid">
            @foreach (var product in Model.AllProducts)
            {
                <partial name="_ProductCard" model="product" />
            }
        </div>
    </section>

    <!-- 4. Customer Testimonials & Reviews Carousel -->
    <section style="background: var(--bg-card); border-radius: var(--radius-lg); box-shadow: var(--shadow-raised); padding: 48px; border: 1px solid rgba(255,255,255,0.9); margin-bottom: 60px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 36px; flex-wrap: wrap; gap: 16px;">
            <div>
                <span style="color: var(--accent-orange); font-weight: 700; font-size: 0.85rem; text-transform: uppercase;">Verified Food Lovers</span>
                <h2 style="font-size: 2rem; margin-top: 4px;">What Customers Say</h2>
            </div>
            <button type="button" class="tjp-btn tjp-btn-primary tjp-write-review-btn" data-product-id="1" data-product-name="Applewood Smoked Heritage Bacon">
                <i class="fa-solid fa-pen-to-square"></i> Write a Review
            </button>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
            @foreach (var review in Model.CustomerReviews)
            {
                <div class="tjp-card" style="box-shadow: var(--shadow-raised-sm); background: var(--bg-surface); display: flex; flex-direction: column; justify-content: space-between;">
                    <div>
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                            <div style="color: #F1C40F; font-size: 0.95rem;">
                                @for (int s = 1; s <= 5; s++)
                                {
                                    <i class="fa-solid fa-star" style="@(s <= review.Rating ? "" : "color: #CBD5E1;")"></i>
                                }
                            </div>
                            @if (review.IsVerifiedBuyer)
                            {
                                <span style="font-size: 0.75rem; color: var(--accent-green); font-weight: 700;"><i class="fa-solid fa-circle-check"></i> Verified Buyer</span>
                            }
                        </div>
                        <h4 style="font-size: 1.05rem; margin-bottom: 8px; color: var(--text-primary);">"@review.Title"</h4>
                        <p style="font-size: 0.9rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 16px;">
                            @review.Comment
                        </p>
                    </div>

                    <div style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid rgba(218,225,233,0.6); padding-top: 12px; font-size: 0.82rem; color: var(--text-muted);">
                        <span style="font-weight: 600; color: var(--text-primary);"><i class="fa-solid fa-user-check" style="color: var(--accent-orange); margin-right: 6px;"></i>@review.CustomerName</span>
                        <span>@review.CreatedAt.ToString("MMM dd, yyyy")</span>
                    </div>
                </div>
            }
        </div>
    </section>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Live category chip filter
            const filterBtns = document.querySelectorAll('.filter-category-btn');
            const productCards = document.querySelectorAll('.tjp-product-card');

            filterBtns.forEach(btn => {
                btn.addEventListener('click', function () {
                    filterBtns.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');

                    const catId = this.dataset.categoryId;
                    productCards.forEach(card => {
                        if (catId === '0' || card.dataset.categoryId === catId) {
                            card.style.display = 'flex';
                        } else {
                            card.style.display = 'none';
                        }
                    });
                });
            });

            // Home sort
            const sortSelect = document.querySelector('#homeSortSelect');
            const grid = document.querySelector('#homeProductGrid');

            if (sortSelect && grid) {
                sortSelect.addEventListener('change', function () {
                    const cardsArray = Array.from(productCards);
                    const val = this.value;

                    cardsArray.sort((a, b) => {
                        const priceA = parseFloat(a.dataset.price);
                        const priceB = parseFloat(b.dataset.price);
                        if (val === 'price-low') return priceA - priceB;
                        if (val === 'price-high') return priceB - priceA;
                        return 0;
                    });

                    cardsArray.forEach(card => grid.appendChild(card));
                });
            }
        });
    </script>
}
