@{
    ViewData["Title"] = "Privacy Policy & Sourcing Transparency";
}

<div class="container" style="margin-top: 110px; margin-bottom: 80px;">
    <div class="tjp-card" style="max-width: 800px; margin: 0 auto; padding: 48px;">
        <h1 style="font-size: 2.2rem; margin-bottom: 16px;">Privacy Policy &amp; Data Transparency</h1>
        <p style="color: var(--text-secondary); line-height: 1.7; margin-bottom: 24px;">
            At T&amp;JPork, we respect your personal data and privacy as much as we value the ethical standards of our farms.
        </p>

        <h3 style="font-size: 1.3rem; margin: 24px 0 10px;">1. Information We Collect</h3>
        <p style="color: var(--text-secondary); line-height: 1.7; margin-bottom: 16px;">
            When you place an order or register, we collect your name, email, phone number, and delivery address to fulfill and route cold-chain packages to your home.
        </p>

        <h3 style="font-size: 1.3rem; margin: 24px 0 10px;">2. Payment Security</h3>
        <p style="color: var(--text-secondary); line-height: 1.7; margin-bottom: 16px;">
            We do not store raw credit card numbers on our servers. All digital payments are processed through PCI-DSS compliant payment gateways.
        </p>

        <h3 style="font-size: 1.3rem; margin: 24px 0 10px;">3. Contact Us</h3>
        <p style="color: var(--text-secondary); line-height: 1.7;">
            For privacy inquiries or account deletions, contact Tinashe &amp; Jeffery directly at <strong>orders@tjpork.com</strong>.
        </p>
    </div>
</div>
