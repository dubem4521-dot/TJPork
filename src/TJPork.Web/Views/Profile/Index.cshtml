@model TJPork.Web.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "My Account & Orders - T&JPork";
}

<div class="container" style="margin-top: 110px; margin-bottom: 80px;">
    <!-- Profile Header Banner -->
    <div class="tjp-card" style="padding: 32px; margin-bottom: 36px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 24px;">
        <div style="display: flex; align-items: center; gap: 20px;">
            <div style="width: 84px; height: 84px; border-radius: var(--radius-full); overflow: hidden; border: 3px solid var(--accent-orange); box-shadow: var(--shadow-raised-sm);">
                <img src="@Model.AvatarUrl" alt="@Model.FullName" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/images/avatars/default.png'" />
            </div>
            <div>
                <h1 style="font-size: 1.8rem; margin-bottom: 4px;">@Model.FullName</h1>
                <div style="font-size: 0.9rem; color: var(--text-secondary); display: flex; gap: 14px; flex-wrap: wrap;">
                    <span><i class="fa-solid fa-envelope" style="color: var(--accent-orange); margin-right: 6px;"></i>@Model.Email</span>
                    <span><i class="fa-solid fa-phone" style="color: var(--accent-green); margin-right: 6px;"></i>@(string.IsNullOrEmpty(Model.PhoneNumber) ? "No phone" : Model.PhoneNumber)</span>
                </div>
            </div>
        </div>

        <form asp-controller="Account" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="tjp-btn tjp-btn-neu tjp-btn-sm" style="color: var(--danger);">
                <i class="fa-solid fa-arrow-right-from-bracket"></i> Sign Out
            </button>
        </form>
    </div>

    <!-- Account Statistics Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 36px;">
        <div class="tjp-metric-card">
            <div>
                <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600;">Total Orders Placed</div>
                <div class="mono" style="font-size: 1.8rem; font-weight: 800; color: var(--text-primary);">@Model.TotalOrdersCount</div>
            </div>
            <div class="tjp-metric-icon" style="background: var(--accent-orange-light); color: var(--accent-orange);">
                <i class="fa-solid fa-bag-shopping"></i>
            </div>
        </div>

        <div class="tjp-metric-card">
            <div>
                <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600;">Lifetime Pork Spend</div>
                <div class="mono" style="font-size: 1.8rem; font-weight: 800; color: var(--accent-green);">R@(Model.TotalSpent.ToString("F2"))</div>
            </div>
            <div class="tjp-metric-icon" style="background: var(--accent-green-light); color: var(--accent-green);">
                <i class="fa-solid fa-wallet"></i>
            </div>
        </div>

        <div class="tjp-metric-card">
            <div>
                <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600;">Smokehouse Points</div>
                <div class="mono" style="font-size: 1.8rem; font-weight: 800; color: #3498DB;">@Model.LoyaltyPoints pts</div>
            </div>
            <div class="tjp-metric-icon" style="background: #EBF5FB; color: #3498DB;">
                <i class="fa-solid fa-award"></i>
            </div>
        </div>

        <div class="tjp-metric-card">
            <div>
                <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600;">Member Since</div>
                <div style="font-size: 1.2rem; font-weight: 700; color: var(--text-primary); margin-top: 4px;">@Model.MemberSince.ToString("MMM yyyy")</div>
            </div>
            <div class="tjp-metric-icon" style="background: #FEF9E7; color: #F1C40F;">
                <i class="fa-solid fa-calendar-check"></i>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div style="padding: 14px 20px; background: var(--accent-green-light); color: var(--accent-green); border-radius: var(--radius-md); border-left: 5px solid var(--accent-green); margin-bottom: 24px; font-weight: 600;">
            <i class="fa-solid fa-circle-check"></i> @TempData["SuccessMessage"]
        </div>
    }

    <!-- Tabbed Navigation -->
    <div class="tjp-card" style="padding: 0; overflow: hidden;">
        <!-- Tab Headers -->
        <div style="display: flex; overflow-x: auto; background: var(--bg-surface); border-bottom: 1px solid #EEF2F6; padding: 6px 12px; gap: 8px;">
            <button type="button" class="tjp-btn tjp-btn-neu profile-tab-btn active" data-tab="activeOrders">
                <i class="fa-solid fa-truck-fast"></i> Active Orders (@Model.ActiveOrders.Count)
            </button>
            <button type="button" class="tjp-btn tjp-btn-neu profile-tab-btn" data-tab="orderHistory">
                <i class="fa-solid fa-clock-rotate-left"></i> Order History (@Model.OrderHistory.Count)
            </button>
            <button type="button" class="tjp-btn tjp-btn-neu profile-tab-btn" data-tab="savedAddresses">
                <i class="fa-solid fa-location-dot"></i> Saved Addresses (@Model.SavedAddresses.Count)
            </button>
            <button type="button" class="tjp-btn tjp-btn-neu profile-tab-btn" data-tab="personalInfo">
                <i class="fa-solid fa-user-gear"></i> Personal Info
            </button>
            <button type="button" class="tjp-btn tjp-btn-neu profile-tab-btn" data-tab="paymentMethods">
                <i class="fa-solid fa-credit-card"></i> Payment Methods
            </button>
        </div>

        <div style="padding: 32px;">
            <!-- TAB 1: Active Orders -->
            <div id="tab-activeOrders" class="profile-tab-content">
                <h3 style="font-size: 1.3rem; margin-bottom: 20px;">Active &amp; In-Transit Orders</h3>

                @if (!Model.ActiveOrders.Any())
                {
                    <div style="text-align: center; padding: 40px 20px; color: var(--text-muted);">
                        <i class="fa-solid fa-box-open fa-3x" style="margin-bottom: 12px;"></i>
                        <p>You have no active orders in preparation right now.</p>
                        <a asp-controller="Shop" asp-action="Index" class="tjp-btn tjp-btn-primary tjp-btn-sm" style="margin-top: 14px;">Shop Fresh Pork Cuts</a>
                    </div>
                }
                else
                {
                    <div style="display: flex; flex-direction: column; gap: 24px;">
                        @foreach (var order in Model.ActiveOrders)
                        {
                            <div class="tjp-card" style="box-shadow: var(--shadow-raised-sm); background: var(--bg-surface); padding: 24px;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 12px;">
                                    <div>
                                        <span class="mono" style="font-weight: 800; font-size: 1.1rem; color: var(--accent-orange);">#@order.OrderNumber</span>
                                        <span style="font-size: 0.82rem; color: var(--text-muted); margin-left: 10px;">Placed @order.CreatedAt.ToString("MMM dd, yyyy")</span>
                                    </div>
                                    <span class="tjp-chip" style="background: var(--accent-orange); color: #FFFFFF; font-weight: 700;">
                                        <i class="fa-solid fa-spinner fa-spin"></i> @order.DeliveryStatus
                                    </span>
                                </div>

                                <!-- 5-Stage Status Visual Tracker -->
                                <div style="margin: 24px 0 32px;">
                                    @{
                                        int stepIndex = order.DeliveryStatus switch {
                                            OrderStatus.Pending => 1,
                                            OrderStatus.Processing => 2,
                                            OrderStatus.Shipped => 3,
                                            OrderStatus.Delivered => 5,
                                            _ => 2
                                        };
                                    }
                                    <div style="display: grid; grid-template-columns: repeat(4, 1fr); text-align: center; position: relative;">
                                        <!-- Step 1 -->
                                        <div>
                                            <div style="width: 32px; height: 32px; border-radius: var(--radius-full); background: @(stepIndex >= 1 ? "var(--accent-green)" : "#E2E8F0"); color: #FFFFFF; display: flex; align-items: center; justify-content: center; margin: 0 auto 6px; font-size: 0.85rem;">
                                                <i class="fa-solid fa-receipt"></i>
                                            </div>
                                            <span style="font-size: 0.78rem; font-weight: 600;">Placed</span>
                                        </div>
                                        <!-- Step 2 -->
                                        <div>
                                            <div style="width: 32px; height: 32px; border-radius: var(--radius-full); background: @(stepIndex >= 2 ? "var(--accent-orange)" : "#E2E8F0"); color: #FFFFFF; display: flex; align-items: center; justify-content: center; margin: 0 auto 6px; font-size: 0.85rem;">
                                                <i class="fa-solid fa-fire-burner"></i>
                                            </div>
                                            <span style="font-size: 0.78rem; font-weight: 600;">Butcher Prep</span>
                                        </div>
                                        <!-- Step 3 -->
                                        <div>
                                            <div style="width: 32px; height: 32px; border-radius: var(--radius-full); background: @(stepIndex >= 3 ? "var(--accent-green)" : "#E2E8F0"); color: #FFFFFF; display: flex; align-items: center; justify-content: center; margin: 0 auto 6px; font-size: 0.85rem;">
                                                <i class="fa-solid fa-truck-fast"></i>
                                            </div>
                                            <span style="font-size: 0.78rem; font-weight: 600;">Out for Delivery</span>
                                        </div>
                                        <!-- Step 4 -->
                                        <div>
                                            <div style="width: 32px; height: 32px; border-radius: var(--radius-full); background: @(stepIndex >= 4 ? "var(--accent-green)" : "#E2E8F0"); color: #FFFFFF; display: flex; align-items: center; justify-content: center; margin: 0 auto 6px; font-size: 0.85rem;">
                                                <i class="fa-solid fa-circle-check"></i>
                                            </div>
                                            <span style="font-size: 0.78rem; font-weight: 600;">Delivered</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Items List -->
                                <div style="border-top: 1px solid rgba(218,225,233,0.6); padding-top: 14px;">
                                    @foreach (var it in order.Items)
                                    {
                                        <div style="display: flex; justify-content: space-between; font-size: 0.9rem; margin-bottom: 6px;">
                                            <span>@it.ProductName &times; @it.Quantity</span>
                                            <span class="mono" style="font-weight: 600;">R@(it.TotalPrice.ToString("F2"))</span>
                                        </div>
                                    }
                                    <div style="display: flex; justify-content: space-between; font-size: 1.05rem; font-weight: 800; border-top: 1px solid #E2E8F0; padding-top: 10px; margin-top: 10px;">
                                        <span>Total:</span>
                                        <span class="mono" style="color: var(--accent-orange);">R@(order.TotalAmount.ToString("F2"))</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- TAB 2: Order History -->
            <div id="tab-orderHistory" class="profile-tab-content" style="display: none;">
                <h3 style="font-size: 1.3rem; margin-bottom: 20px;">Past Orders</h3>
                @if (!Model.OrderHistory.Any())
                {
                    <p style="color: var(--text-muted); text-align: center; padding: 30px;">No completed past orders yet.</p>
                }
                else
                {
                    <div style="display: flex; flex-direction: column; gap: 16px;">
                        @foreach (var order in Model.OrderHistory)
                        {
                            <div class="tjp-card" style="background: #FFFFFF; padding: 20px; box-shadow: var(--shadow-raised-sm);">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap;">
                                    <div>
                                        <span class="mono" style="font-weight: 700; font-size: 1.05rem;">#@order.OrderNumber</span>
                                        <span style="font-size: 0.82rem; color: var(--text-muted); margin-left: 10px;">Delivered @(order.DeliveredAt?.ToString("MMM dd, yyyy") ?? order.CreatedAt.ToString("MMM dd, yyyy"))</span>
                                    </div>
                                    <span style="font-size: 0.82rem; color: var(--accent-green); font-weight: 700;"><i class="fa-solid fa-circle-check"></i> Completed</span>
                                </div>
                                <div style="font-size: 0.88rem; color: var(--text-secondary); margin-bottom: 10px;">
                                    @string.Join(", ", order.Items.Select(i => $"{i.ProductName} ({i.Quantity})"))
                                </div>
                                <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #F1F5F9; padding-top: 10px;">
                                    <span class="mono" style="font-weight: 700; font-size: 1.1rem; color: var(--accent-orange);">R@(order.TotalAmount.ToString("F2"))</span>
                                    <a asp-controller="Shop" asp-action="Index" class="tjp-btn tjp-btn-neu tjp-btn-sm"><i class="fa-solid fa-repeat"></i> Re-order Items</a>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- TAB 3: Saved Addresses -->
            <div id="tab-savedAddresses" class="profile-tab-content" style="display: none;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                    <h3 style="font-size: 1.3rem; margin: 0;">Your Delivery Addresses</h3>
                </div>

                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 32px;">
                    @foreach (var addr in Model.SavedAddresses)
                    {
                        <div class="tjp-card" style="box-shadow: var(--shadow-raised-sm); background: var(--bg-surface); position: relative;">
                            @if (addr.IsDefault)
                            {
                                <span class="tjp-badge" style="position: absolute; top: 12px; right: 12px; background: var(--accent-green); border-radius: 4px; padding: 2px 8px;">DEFAULT</span>
                            }
                            <h4 style="font-size: 1.05rem; margin-bottom: 8px;"><i class="fa-solid fa-house" style="color: var(--accent-orange); margin-right: 6px;"></i> @addr.Label</h4>
                            <p style="font-size: 0.9rem; margin-bottom: 2px;"><strong>@addr.RecipientName</strong></p>
                            <p style="font-size: 0.88rem; color: var(--text-secondary); margin-bottom: 2px;">@addr.StreetAddress</p>
                            <p style="font-size: 0.88rem; color: var(--text-secondary); margin-bottom: 8px;">@addr.City, @addr.PostalCode</p>
                            <p style="font-size: 0.84rem; color: var(--text-muted);"><i class="fa-solid fa-phone" style="margin-right: 4px;"></i> @addr.Phone</p>

                            <form asp-action="DeleteAddress" method="post" style="margin-top: 14px; border-top: 1px solid rgba(218,225,233,0.6); padding-top: 10px;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@addr.Id" />
                                <button type="submit" class="tjp-btn tjp-btn-neu tjp-btn-sm" style="color: var(--danger); font-size: 0.78rem;">
                                    <i class="fa-solid fa-trash-can"></i> Delete
                                </button>
                            </form>
                        </div>
                    }
                </div>

                <!-- Add New Address Form -->
                <div class="tjp-card" style="padding: 24px; background: #FFFFFF; border: 1px solid #EEF2F6;">
                    <h4 style="font-size: 1.1rem; margin-bottom: 16px;"><i class="fa-solid fa-plus" style="color: var(--accent-orange); margin-right: 6px;"></i> Add New Delivery Address</h4>
                    <form asp-action="AddAddress" method="post">
                        @Html.AntiForgeryToken()
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                            <div class="tjp-input-group">
                                <label class="tjp-label">Address Label (e.g. Home, Office)</label>
                                <input name="Label" class="tjp-input" value="Home" required />
                            </div>
                            <div class="tjp-input-group">
                                <label class="tjp-label">Recipient Name</label>
                                <input name="RecipientName" class="tjp-input" value="@Model.FullName" required />
                            </div>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                            <div class="tjp-input-group">
                                <label class="tjp-label">Phone Number</label>
                                <input name="Phone" class="tjp-input" value="@Model.PhoneNumber" required />
                            </div>
                            <div class="tjp-input-group">
                                <label class="tjp-label">Street Address</label>
                                <input name="StreetAddress" class="tjp-input" required />
                            </div>
                        </div>

                        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 16px;">
                            <div class="tjp-input-group">
                                <label class="tjp-label">City</label>
                                <input name="City" class="tjp-input" value="Cape Town" required />
                            </div>
                            <div class="tjp-input-group">
                                <label class="tjp-label">Postal Code</label>
                                <input name="PostalCode" class="tjp-input" required />
                            </div>
                        </div>

                        <label style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px; cursor: pointer; font-size: 0.9rem;">
                            <input type="checkbox" name="IsDefault" value="true" style="accent-color: var(--accent-orange);" />
                            <span>Set as default delivery address</span>
                        </label>

                        <button type="submit" class="tjp-btn tjp-btn-primary tjp-btn-sm"><i class="fa-solid fa-floppy-disk"></i> Save Address</button>
                    </form>
                </div>
            </div>

            <!-- TAB 4: Personal Info -->
            <div id="tab-personalInfo" class="profile-tab-content" style="display: none;">
                <h3 style="font-size: 1.3rem; margin-bottom: 20px;">Edit Personal Details</h3>
                <form asp-action="UpdateProfile" method="post" style="max-width: 600px;">
                    @Html.AntiForgeryToken()

                    <div class="tjp-input-group">
                        <label class="tjp-label">Full Name</label>
                        <input type="text" name="fullName" value="@Model.FullName" class="tjp-input" required />
                    </div>

                    <div class="tjp-input-group">
                        <label class="tjp-label">Phone Number</label>
                        <input type="tel" name="phoneNumber" value="@Model.PhoneNumber" class="tjp-input" />
                    </div>

                    <div class="tjp-input-group">
                        <label class="tjp-label">Default Delivery Street Address</label>
                        <input type="text" name="deliveryAddress" value="@Model.DeliveryAddress" class="tjp-input" />
                    </div>

                    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 16px;">
                        <div class="tjp-input-group">
                            <label class="tjp-label">City</label>
                            <input type="text" name="city" value="@Model.City" class="tjp-input" />
                        </div>
                        <div class="tjp-input-group">
                            <label class="tjp-label">Postal Code</label>
                            <input type="text" name="postalCode" value="@Model.PostalCode" class="tjp-input" />
                        </div>
                    </div>

                    <button type="submit" class="tjp-btn tjp-btn-primary"><i class="fa-solid fa-floppy-disk"></i> Update Profile</button>
                </form>
            </div>

            <!-- TAB 5: Payment Methods -->
            <div id="tab-paymentMethods" class="profile-tab-content" style="display: none;">
                <h3 style="font-size: 1.3rem; margin-bottom: 20px;">Saved Payment Methods</h3>
                <div class="tjp-card" style="background: var(--bg-surface); padding: 24px; box-shadow: var(--shadow-inset-sm); max-width: 480px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
                        <span style="font-weight: 700; font-size: 1rem;"><i class="fa-brands fa-cc-visa fa-lg" style="color: #1A1F71; margin-right: 8px;"></i> Visa ending in 8921</span>
                        <span class="tjp-badge" style="position: static; background: var(--accent-green);">DEFAULT</span>
                    </div>
                    <div style="font-size: 0.88rem; color: var(--text-secondary); margin-bottom: 6px;">Expires 09/28 &bull; Marcus Sterling</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const tabBtns = document.querySelectorAll('.profile-tab-btn');
            const tabContents = document.querySelectorAll('.profile-tab-content');

            tabBtns.forEach(btn => {
                btn.addEventListener('click', function () {
                    tabBtns.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');

                    const targetTab = this.dataset.tab;
                    tabContents.forEach(content => {
                        content.style.display = content.id === `tab-${targetTab}` ? 'block' : 'none';
                    });
                });
            });
        });
    </script>
}
