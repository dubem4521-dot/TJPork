@using Microsoft.AspNetCore.Identity
@using TJPork.Infrastructure.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    var currentUser = await UserManager.GetUserAsync(User);
    var ownerName = currentUser?.FullName ?? "Store Owner";
    var ownerEmail = currentUser?.Email ?? "admin@tjpork.com";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Dashboard | T&amp;JPork</title>

    <!-- FontAwesome 6 (No emojis used anywhere) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Google Fonts Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

    <!-- Neumorphic Luxury Design System -->
    <link rel="stylesheet" href="~/css/neumorphism.css" asp-append-version="true" />

    <!-- Chart.js CDN for Analytics -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body style="background: var(--bg-main);">
    <div class="admin-wrapper">
        <!-- Sidebar Navigation -->
        <aside class="admin-sidebar">
            <div class="admin-sidebar-header">
                <a asp-controller="Admin" asp-action="Index" style="display: flex; align-items: center; gap: 10px; color: #FFFFFF; font-weight: 800; font-size: 1.25rem;">
                    <div style="width: 34px; height: 34px; border-radius: var(--radius-sm); background: var(--accent-orange); display: flex; align-items: center; justify-content: center;">
                        <i class="fa-solid fa-gauge-high"></i>
                    </div>
                    <span>T&amp;J <span style="color: var(--accent-orange);">Admin</span></span>
                </a>
            </div>

            <ul class="admin-nav">
                <li class="admin-nav-item">
                    <a asp-controller="Admin" asp-action="Index" class="admin-nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                        <i class="fa-solid fa-chart-pie"></i>
                        <span>Overview</span>
                    </a>
                </li>
                <li class="admin-nav-item">
                    <a asp-controller="Admin" asp-action="Orders" class="admin-nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Orders" ? "active" : "")">
                        <i class="fa-solid fa-clipboard-list"></i>
                        <span>Orders</span>
                    </a>
                </li>
                <li class="admin-nav-item">
                    <a asp-controller="Admin" asp-action="Products" class="admin-nav-link @(ViewContext.RouteData.Values["Action"]?.ToString()?.Contains("Product") == true ? "active" : "")">
                        <i class="fa-solid fa-drumstick-bite"></i>
                        <span>Products (CRUD)</span>
                    </a>
                </li>
                <li class="admin-nav-item">
                    <a asp-controller="Admin" asp-action="Customers" class="admin-nav-link @(ViewContext.RouteData.Values["Action"]?.ToString()?.Contains("Customer") == true ? "active" : "")">
                        <i class="fa-solid fa-users"></i>
                        <span>Customers</span>
                    </a>
                </li>
                <li class="admin-nav-item">
                    <a asp-controller="Admin" asp-action="Analytics" class="admin-nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Analytics" ? "active" : "")">
                        <i class="fa-solid fa-chart-line"></i>
                        <span>Analytics &amp; CSV</span>
                    </a>
                </li>
                <li class="admin-nav-item">
                    <a asp-controller="Admin" asp-action="Settings" class="admin-nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Settings" ? "active" : "")">
                        <i class="fa-solid fa-sliders"></i>
                        <span>Store Settings</span>
                    </a>
                </li>
            </ul>

            <div style="padding: 20px; border-top: 1px solid rgba(255, 255, 255, 0.1);">
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 14px;">
                    <img src="@(currentUser?.AvatarUrl ?? "/images/avatars/default.png")" alt="Owner" style="width: 40px; height: 40px; border-radius: var(--radius-full); object-fit: cover; border: 2px solid var(--accent-orange);" />
                    <div style="overflow: hidden;">
                        <div style="font-weight: 700; font-size: 0.9rem; color: #FFFFFF; text-overflow: ellipsis; white-space: nowrap;">@ownerName</div>
                        <div style="font-size: 0.75rem; color: var(--accent-orange); text-overflow: ellipsis; white-space: nowrap;">Co-Founder / Admin</div>
                    </div>
                </div>

                <form asp-controller="Admin" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="tjp-btn tjp-btn-neu tjp-btn-sm" style="width: 100%; color: #E74C3C; background: rgba(231,76,60,0.1); border-color: rgba(231,76,60,0.3);">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i>
                        <span>Sign Out</span>
                    </button>
                </form>
            </div>
        </aside>

        <!-- Main Content Area -->
        <div class="admin-main">
            <!-- Top Bar -->
            <header class="admin-topbar">
                <div style="display: flex; align-items: center; gap: 16px;">
                    <button type="button" id="sidebarToggleBtn" class="tjp-icon-btn" style="width: 40px; height: 40px;">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <h2 style="font-size: 1.35rem; margin: 0;">@ViewData["Title"]</h2>
                </div>

                <div style="display: flex; align-items: center; gap: 16px;">
                    <a asp-controller="Home" asp-action="Index" target="_blank" class="tjp-btn tjp-btn-neu tjp-btn-sm" title="View Customer Storefront">
                        <i class="fa-solid fa-arrow-up-right-from-square"></i>
                        <span>View Store</span>
                    </a>
                </div>
            </header>

            <!-- Content Slot -->
            <main class="admin-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div style="padding: 14px 20px; background: var(--accent-green-light); color: var(--accent-green); border-radius: var(--radius-md); border-left: 5px solid var(--accent-green); margin-bottom: 24px; display: flex; align-items: center; gap: 12px; font-weight: 600;">
                        <i class="fa-solid fa-circle-check"></i>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div style="padding: 14px 20px; background: var(--danger-light); color: var(--danger); border-radius: var(--radius-md); border-left: 5px solid var(--danger); margin-bottom: 24px; display: flex; align-items: center; gap: 12px; font-weight: 600;">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <span>@TempData["ErrorMessage"]</span>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Admin Modals Container (Order details modal) -->
    <div id="adminOrderModal" class="tjp-modal-overlay" style="display: none; position: fixed; inset: 0; background: rgba(44,62,80,0.6); backdrop-filter: blur(4px); z-index: 2100; align-items: center; justify-content: center; padding: 20px;">
        <div class="tjp-card" style="max-width: 760px; width: 100%; max-height: 90vh; overflow-y: auto; position: relative;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #EEF2F6; padding-bottom: 14px;">
                <h3 style="font-size: 1.3rem;"><i class="fa-solid fa-receipt" style="color: var(--accent-orange); margin-right: 8px;"></i> Order Details</h3>
                <button type="button" class="tjp-icon-btn admin-modal-close" style="width: 34px; height: 34px;"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="admin-modal-body"></div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
